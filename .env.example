# 复制为 .env 后填入真实值：cp .env.example .env
# 各项取值位置：Supabase 控制台 → Project Settings → API / Database

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 数据库连接：用 Connection Pooling 那一栏的地址，不要用 Direct connection
# （direct connection 是纯 IPv6，多数家用/办公网络连不通）
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=<database-password>

DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Next.js 前端读取这两个（NEXT_PUBLIC_ 前缀会打包进浏览器，只能放可公开的 publishable key）
# 部署到 Vercel 时，在 Project Settings → Environment Variables 里填同样两项
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
